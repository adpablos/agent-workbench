{
  "description": "Approved scope and pins for this workbench. Change only after the requester approves the exact content.",
  "approved": "YYYY-MM-DD",
  "core": {
    "path": "core",
    "revision": "<commit SHA>",
    "previous_revision": "<commit SHA before the last update>"
  },
  "sources": [
    {
      "name": "example-service",
      "kind": "repository",
      "location": "/path/to/example-service",
      "access": "read"
    },
    {
      "name": "team-wiki",
      "kind": "documentation",
      "location": "https://wiki.example.com/display/TEAM",
      "access": "read"
    }
  ],
  "writable": ["private", "repos", "work"],
  "tools": [
    {
      "name": "example-cli",
      "revision": "<tag or commit SHA>",
      "location": "tools/example-cli",
      "status": "pending approval"
    }
  ]
}
