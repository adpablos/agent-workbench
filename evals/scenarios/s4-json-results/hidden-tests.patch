+)
+async def test_flow_json_result_with_record_like_keys(value, prefect_client):
+    @flow(result_serializer="json", persist_result=True)
+    def foo():
+        return value
+
+    state = foo(return_state=True)
+    assert await state.result() == value
+
+    api_state = (
